# URL base de la API. Puede ser relativa (/api) o absoluta (https://api.flowcommerce.com/v1)
VITE_API_URL=/api

# true = usa datos simulados en memoria (sin backend). false = llama a la API real.
VITE_USE_MOCKS=true

# Opcional: en desarrollo redirige /api hacia el backend local (evita CORS)
# VITE_API_PROXY=http://localhost:3000
